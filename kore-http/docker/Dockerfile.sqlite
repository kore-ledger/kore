#docker build --platform linux/arm64 --build-arg FEATURES="sqlite prometheus ext-sqlite" -t koreledgerhub/kore-http:arm64-sqlite-prometheus --target arm64 -f ./kore/kore-http/docker/Dockerfile.sqlite .
#docker build --platform linux/amd64 --build-arg FEATURES="sqlite prometheus ext-sqlite" -t koreledgerhub/kore-http:amd64-sqlite-prometheus --target amd64 -f ./kore/kore-http/docker/Dockerfile.sqlite .

# Etapa de compilación para AMD64
FROM rust:1.99-bookworm AS builder-amd64
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pkg-config libssl-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-gnu

# Argumento de construcción para features
ARG FEATURES=""
ENV CARGO_FEATURES=$FEATURES

# Kore
COPY ./kore/kore-http/src ./kore/kore-http/src
COPY ./kore/kore-http/Cargo.toml ./kore/kore-http/Cargo.toml

COPY ./kore/identity/src ./kore/identity/src
COPY ./kore/identity/Cargo.toml ./kore/identity/Cargo.toml

COPY ./kore/kore-base/src ./kore/kore-base/src
COPY ./kore/kore-base/Cargo.toml ./kore/kore-base/Cargo.toml

COPY ./kore/kore-common/src ./kore/kore-common/src
COPY ./kore/kore-common/Cargo.toml ./kore/kore-common/Cargo.toml

COPY ./kore/kore-bridge/src ./kore/kore-bridge/src
COPY ./kore/kore-bridge/Cargo.toml ./kore/kore-bridge/Cargo.toml

COPY ./kore/network/src ./kore/network/src
COPY ./kore/network/Cargo.toml ./kore/network/Cargo.toml

COPY ./kore/protocols/tell/src ./kore/protocols/tell/src
COPY ./kore/protocols/tell/Cargo.toml ./kore/protocols/tell/Cargo.toml

COPY ./kore/kore-client/src ./kore/kore-client/src
COPY ./kore/kore-client/Cargo.toml ./kore/kore-client/Cargo.toml

COPY ./kore/Cargo.toml ./kore/Cargo.toml

WORKDIR /kore/kore-http
RUN cargo build --target x86_64-unknown-linux-gnu --release --no-default-features --features "$CARGO_FEATURES"

# Etapa de compilación para ARM64
FROM rust:1.99-slim-bookworm AS builder-arm64
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pkg-config libssl-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu

# Argumento de construcción para features
ARG FEATURES=""
ENV CARGO_FEATURES=$FEATURES

# Kore
COPY ./kore/kore-http/src ./kore/kore-http/src
COPY ./kore/kore-http/Cargo.toml ./kore/kore-http/Cargo.toml

COPY ./kore/identity/src ./kore/identity/src
COPY ./kore/identity/Cargo.toml ./kore/identity/Cargo.toml

COPY ./kore/kore-base/src ./kore/kore-base/src
COPY ./kore/kore-base/Cargo.toml ./kore/kore-base/Cargo.toml

COPY ./kore/kore-common/src ./kore/kore-common/src
COPY ./kore/kore-common/Cargo.toml ./kore/kore-common/Cargo.toml

COPY ./kore/kore-bridge/src ./kore/kore-bridge/src
COPY ./kore/kore-bridge/Cargo.toml ./kore/kore-bridge/Cargo.toml

COPY ./kore/network/src ./kore/network/src
COPY ./kore/network/Cargo.toml ./kore/network/Cargo.toml

COPY ./kore/protocols/tell/src ./kore/protocols/tell/src
COPY ./kore/protocols/tell/Cargo.toml ./kore/protocols/tell/Cargo.toml

COPY ./kore/kore-client/src ./kore/kore-client/src
COPY ./kore/kore-client/Cargo.toml ./kore/kore-client/Cargo.toml

COPY ./kore/Cargo.toml ./kore/Cargo.toml

WORKDIR /kore/kore-http
RUN cargo build --target aarch64-unknown-linux-gnu --release --no-default-features --features "$CARGO_FEATURES"

# Imagen final para AMD64
FROM rust:1.99-bookworm AS amd64
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libsqlite3-0 ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder-amd64 ./kore/target/x86_64-unknown-linux-gnu/release/kore-http /usr/local/bin/kore-node
RUN rustup target add wasm32-unknown-unknown

CMD ["kore-node"]

# Imagen final para ARM64
FROM rust:1.99-bookworm AS arm64
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libsqlite3-0 ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder-arm64 ./kore/target/aarch64-unknown-linux-gnu/release/kore-http /usr/local/bin/kore-node
RUN rustup target add wasm32-unknown-unknown

CMD ["kore-node"]